      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pharmacodynamics of Piperacillin-Tazobactam/Amikacin Combination versus Meropenem against Extended-Spectrum Î²-Lactamase-Producing Escherichia coli in a Hollow Fiber Infection Model</rdf:li>
        </rdf:Alt>
      </dc:title>
